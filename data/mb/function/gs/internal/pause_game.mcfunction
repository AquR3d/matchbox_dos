# will pause the game based on the current game state...

# first we check if the pause transiiton exists for this game state...
$execute unless data storage mb:data const.game_state_tick_functions[{game_state:"$(current_game_state)"}].pause_transition run return fail

# set paused game state to the macro current game state...
$data modify storage mb:data game.paused_game_state set value "$(current_game_state)"

# run pause transition otherwise...
# setup args...
$data modify storage util:registers args.cmd set from storage mb:data const.game_state_tick_functions[{game_state:"$(current_game_state)"}].pause_transition
# run transition...
function util:run_command

# set game state to paused...
data modify storage mb:data game.current_game_state set value "PAUSED"