# this function will store in storage the vote decision...

# first check if there are players ig...
execute unless data storage mb:data game.current_players[] run return run \
tellraw @s {"text":"mb:gm/voting/check_vote_decision: This is a big problem.  There were no players detected in the game. .-.","color":"red"}

# set voting nick to no one...
data modify storage mb:data game.voting.nick set value ""

# get the largest voting decision... get largest votes...
execute store result storage mb:registers args.value int 1.0 run function mb:gm/voting/get_largest_votes

# run internal function with this number...
function mb:gm/internal/check_vote_decision with storage mb:registers args

