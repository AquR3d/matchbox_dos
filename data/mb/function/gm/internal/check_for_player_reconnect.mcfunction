# check if uuid exists...

# if the disconnecgtedd player exists, that means they have reconnect so we reconnect them...
$execute if entity @a[nbt={UUID:$(UUID)}] run function mb:gm/internal/reconnect_player {UUID:$(UUID)}
$execute if entity @a[nbt={UUID:$(UUID)}] run data modify storage mb:registers return.value set value true

# remove from queue... to get to next...
$data remove storage mb:registers disconnected_players_queue[{UUID:$(UUID)}]

# check if queue is empty...
execute unless data storage mb:registers disconnected_players_queue[] run return fail

# otherwise, go again...
function mb:gm/internal/check_for_player_reconnect with storage mb:registers disconnected_players_queue[0]