# we store in storage the shulker box marker...

# check if current position is air...
execute unless block ~ ~ ~ air run return run \
tellraw @s {"text":"util:items/save_shulker_box_marker: Please choose a location that does not interfere with the world.","color":"red"}

# otherwise, save the current position...
data modify storage util:data marker.Pos set from entity @s Pos